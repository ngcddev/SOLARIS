# Copy this file to .env.local. NEVER commit .env.local to the repository.

# --- Meta AI (if META_API_KEY is empty => SIMULATED mode is used automatically) ---
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_TRIAGE_MODEL=muse-spark-1.3
META_ANALYST_MODEL=muse-wonder-1.0
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_VISION_MODEL=sam-3.1
META_TIMEOUT_MS=15000

# --- Level 2: local open Meta model (Llama) via an Ollama-compatible server. Empty = disabled ---
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_TIMEOUT_MS=20000

# --- Command center keys (npm run keys). If missing => ephemeral in-memory pair ---
CENTER_PUBLIC_KEY=
CENTER_SECRET_KEY=

# --- Ingestion ---
REPLAY_WINDOW_S=600
DEDUP_WINDOW_S=120
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10

# --- Seismic events ---
USGS_FEED_ENABLED=false

# --- Postgres (Supabase), optional; without it the in-memory repository is used ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
