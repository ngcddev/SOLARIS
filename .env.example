# Copia este archivo a .env.local. NUNCA subas .env.local al repositorio.

# --- IA de Meta (si META_API_KEY está vacía => modo SIMULADO automático) ---
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_TRIAGE_MODEL=muse-spark-1.0
META_ANALYST_MODEL=muse-wonder-1.0
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
META_VISION_MODEL=sam-3.1
META_TIMEOUT_MS=15000

# --- Llaves del centro de mando (npm run keys). Si faltan => par efímero en memoria ---
CENTER_PUBLIC_KEY=
CENTER_SECRET_KEY=

# --- Ingesta ---
REPLAY_WINDOW_S=600
DEDUP_WINDOW_S=120
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MIN=10

# --- Eventos sísmicos ---
USGS_FEED_ENABLED=false

# --- Postgres (Supabase), opcional; sin esto se usa el repositorio en memoria ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
